# Copy to .env and fill in the secrets. .env is gitignored; never commit it.
#
# Values here target running the services on your HOST against containerized
# Postgres and Redis (`make up`). When services run in containers
# (`make stack`), docker-compose.yml overrides the connection URLs with compose
# service names, so you do not need a second file for that.

# --- LLM provider (Anthropic) ---
# The agent (create_agent / chat) uses this key.
ANTHROPIC_API_KEY=sk-ant-...
MLENG_LLM_MODEL=claude-sonnet-4-5

# User files and MLflow runs. Each account gets data/users/{user_id}/
# (uploads, mlflow.db, artifacts). Never share this directory across people.
MLENG_DATA_DIR=./data
# Set false to skip spawning the MLflow MCP server (local tools still train).
MLENG_ENABLE_MLFLOW_MCP=true

# --- The search ---
# Wall clock each training run gets, in its own process. Every version gets the
# same budget, which is what makes a cheap model and an expensive search
# comparable instead of just differently patient. A script that overruns is
# killed and told to be cheaper. Raise it for large data, lower it for more
# experiments per hour.
MLENG_TRAIN_BUDGET_SECONDS=60
# The fuse on one session, not its stopping rule: the agent decides when the
# search is finished (see agent/prompts/program.md). These only stop a runaway,
# so hitting one means the program needs tuning.
MLENG_MAX_MODEL_CALLS=150
MLENG_MAX_TOOL_CALLS=200

# --- LangSmith tracing ---
# Set LANGSMITH_TRACING=false to run without sending traces anywhere.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=mleng

# --- Services (api + worker) ---
# DATABASE_URL is application state (users, threads, messages, runs) in the
# "app" schema, managed by Alembic. Read by the API and by the worker.
DATABASE_URL=postgresql://mleng:mleng@localhost:5433/mleng
# Redis carries the job queue (api hands work to worker) and the event stream
# that pushes tokens back out to the browser.
REDIS_URL=redis://localhost:6379/0

# development | production. Affects logging, error verbosity, and whether
# cookies are marked Secure. Production also refuses to start without a session
# secret and a domain to restrict sign-in to.
ENVIRONMENT=development

# --- Sign-in (Google) ---
# From a Google Cloud OAuth 2.0 "Web application" client. The redirect URI below
# must be registered on that client verbatim, including scheme and port.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback

# The one domain allowed to sign in. This is the entire access control model:
# anyone with a verified Google account on this domain gets an account as a
# member on first sign-in, and every other account is refused.
ALLOWED_EMAIL_DOMAIN=your-company.com

# The first admin, who cannot be appointed by an admin because there is not one
# yet. This address is also restored to an active admin on every sign-in, so an
# instance cannot be locked out of its own user management.
INITIAL_ADMIN_EMAIL=you@your-company.com

# Signs the session cookie. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Leave it unset in development and one is generated per process, which costs a
# re-login whenever the API restarts. Required in production, where an unset or
# shared secret would let anyone forge a session for any address.
SESSION_SECRET=

# How long a sign-in lasts. Revoking access does not wait for this: role and
# active status are read from the database on every request.
SESSION_TTL_SECONDS=604800

# Where the browser lands after signing in.
POST_LOGIN_REDIRECT=http://localhost:3000

# Origins allowed to call the API from a browser, comma-separated. Must be
# explicit: credentialed cookies cannot be sent to a wildcard origin.
CORS_ORIGINS=http://localhost:3000

# Issues a session for any allowed-domain address without contacting Google, so
# the API and the frontend can be worked on before OAuth credentials exist:
#   curl -c cookies.txt -X POST localhost:8000/auth/dev-login \
#     -H 'content-type: application/json' -d '{"email":"you@your-company.com"}'
# The domain rule still applies. Setting this in production stops the API from
# starting at all.
DEV_LOGIN_ENABLED=false

# --- Production (used by docker-compose.prod.yml / make prod-up) ---
# The DNS name Caddy serves. Required when ENVIRONMENT=production. Compose
# derives OAUTH_REDIRECT_URL, POST_LOGIN_REDIRECT and CORS_ORIGINS from it.
# Register https://<PUBLIC_HOST>/auth/callback on the Google OAuth client.
# PUBLIC_HOST=mleng.example.com
#
# Change this before the stack is reachable from the internet. The compose
# default matches local docker-compose.yml.
# POSTGRES_PASSWORD=...
#
# Optional error tracking. Empty means off; a missing DSN must not stop boot.
SENTRY_DSN=
#
# 60 requests / 60s per client IP. /health and /ready are exempt.
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60
# MAX_REQUEST_BYTES=65536
# MAX_CONCURRENT_RUNS_PER_USER=3

# --- Frontend ---
# The chat UI (Next.js) talks to the API from the browser. CORS_ORIGINS above
# must include this origin, and POST_LOGIN_REDIRECT should send the browser here
# after Google sign-in.
NEXT_PUBLIC_API_URL=http://localhost:8000
